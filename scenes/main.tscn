[node name="Center" type="CenterContainer" parent="Interface/Screen"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Interface/Screen/Center"]
layout_mode = 2
