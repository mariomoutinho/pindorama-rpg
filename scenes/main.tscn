[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scenes/main.gd" id="1_main"]

[sub_resource type="StyleBoxFlat" id="Style_panel"]
bg_color = Color(0.075, 0.13, 0.115, 1)
border_width_left = 1
