[node name="Main" type="Node2D"]
script = ExtResource("1_main")

[node name="Interface" type="CanvasLayer" parent="."]

[node name="Screen" type="Control" parent="Interface"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
